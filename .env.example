# Copy to .env and fill in before deploy:
#   cp .env.example .env

# ---- App image ----
# Use a released tag (recommended) or latest
IMAGE_TAG=latest
# IMAGE_TAG=2.0.0

# Host port mapped to container 8898
APP_PORT=8898

# ---- Required secrets (must change in production) ----
# JWT_SECRET: >= 32 characters
JWT_SECRET=replace-with-at-least-32-char-random-secret
# ENCRYPTION_KEY: exactly 32 characters
ENCRYPTION_KEY=replace-with-32-character-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# ---- Database (internal docker network) ----
POSTGRES_USER=oauth2api
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=oauth2api
# Optional: expose Postgres on host (empty = not published)
# POSTGRES_HOST_PORT=15432

# ---- Optional app settings ----
JWT_EXPIRES_IN=2h
# CORS_ORIGIN=https://admin.example.com
# ADMIN_2FA_SECRET=
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_LOCK_MINUTES=15
# API_LOG_RETENTION_DAYS=30
# TOKEN_REFRESH_ENABLED=true
